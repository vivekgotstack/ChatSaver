{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatSaver",
  "version": "../package.json",
  "identifier": "in.co.viveknigam.chatsaver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../.tauri-build/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChatSaver",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Vivek Nigam. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "A private home for notes, ideas, and knowledge.",
    "longDescription": "ChatSaver is a flexible, local-first knowledge workspace that stays available offline and moves securely across your devices.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    }
  }
}
